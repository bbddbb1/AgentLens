# ─── AgentLens Environment Configuration ───
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# All values below are placeholders for local development.
# Replace them with real values in production.

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://agentlens:agentlens@localhost:5432/agentlens
POSTGRES_USER=agentlens
POSTGRES_PASSWORD=agentlens
POSTGRES_DB=agentlens

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible object storage) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=agentlens
MINIO_SECRET_KEY=agentlens-secret
MINIO_BUCKET=agentlens-artifacts

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8001
API_SECRET_KEY=change-me-in-production
API_CORS_ORIGINS=http://localhost:3000
# Maximum JSON body size for ingest requests (default: 10mb)
# JSON_BODY_LIMIT=10mb
# Timeout in ms for AI-generated semantic summaries (default: 15000)
# SUMMARY_TIMEOUT_MS=15000

# ── WebSocket ──
# Redis URL is used for pub/sub fan-out across multiple API instances.
# If REDIS_URL is unset, WebSocket broadcasting is local-only (single instance).

# ── Frontend (Next.js) ──
# Set these in apps/web/.env.local (not in the root .env):
#   NEXT_PUBLIC_API_URL=http://localhost:8001
#   NEXT_PUBLIC_WS_URL=ws://localhost:8001

# ── OTEL Collector ──
# Endpoint where instrumented apps push OTLP traces.
# The AgentLens API exposes /v1/traces as the native OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8001/v1/traces

# ── Semantic Engine (optional) ──
# The control plane uses an embedded AI agent (@earendil-works/pi-coding-agent)
# for generating natural-language mission summaries and "why this state" explanations.
# When these variables are left commented out, the system falls back to deterministic
# template-based analysis.
#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=openai  # openai | anthropic | ollama
# LLM_MODEL=gpt-4o-mini
# OLLAMA_URL=http://localhost:11434

# ── Demo Scenarios ──
# Used by example scripts in examples/.
# AGENTLENS_ENDPOINT=http://localhost:8001
# AGENTLENS_UI_URL=http://localhost:3000
#
# Optional provider-specific configuration for demo agent teams:
# ROUND_TABLE_BASE_URL=https://your-provider.example/v1
# ROUND_TABLE_API_KEY=sk-...
# ROUND_TABLE_MODEL=your-chat-model
# ROUND_TABLE_TOPIC=How should we launch a privacy-first AI assistant?
# ROUND_TABLE_ROUNDS=2
#
# RELA_AI_BASE_URL=https://your-provider.example/v1
# RELA_AI_API_KEY=sk-...
# RELA_AI_MODEL=your-chat-model
# RELE_AI_BASE_URL=https://your-provider.example/v1
# RELE_AI_API_KEY=sk-...
# RELE_AI_MODEL=your-chat-model
